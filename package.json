  "type": "module",
  "scripts": {
    "web:dev": "vite",
    "web:build": "tsc -b && vite build",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "version:sync": "node scripts/sync-version.js",
